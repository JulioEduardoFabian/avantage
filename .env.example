# Servidor
PORT=3000
# URL base pública donde corre el FRONTEND (Vite), sin slash final. Se usa
# para redirigir de vuelta al navegador tras el consentimiento de Google.
APP_BASE_URL=http://localhost:5173

# Carpeta donde se guardan los archivos subidos (comprobantes, adjuntos de
# proyectos, medios de WhatsApp, etc.). En local se deja vacía (usa `uploads/`
# dentro del repo). EN PRODUCCIÓN con despliegue automático por Git, debe ser
# una ruta ABSOLUTA fuera de la carpeta que gestiona el despliegue — ver la
# nota "Persistencia de uploads entre despliegues" en README.md.
UPLOADS_DIR=

# Google Calendar (conexión por asesor, para crear reuniones con Google Meet)
# Crear en console.cloud.google.com: habilitar "Google Calendar API",
# configurar la pantalla de consentimiento OAuth con el scope
# https://www.googleapis.com/auth/calendar.events, y generar credenciales
# de "ID de cliente de OAuth" tipo "Aplicación web".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Debe coincidir EXACTO con un "URI de redirección autorizado" en Google Cloud.
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback
# ID (tabla users) del asesor cuyo Google Calendar usa el bot de WhatsApp (Avan)
# para agendar llamadas automáticamente al terminar de calificar un lead. Debe
# tener su Google Calendar conectado y su horario configurado en Mi Disponibilidad.
GOOGLE_BOOKING_ADVISOR_USER_ID=1

# Motor de IA usado por el bot de WhatsApp (Avan), el evaluador de viabilidad
# y el resto de servicios de ollamaService.js: "ollama" (por defecto) o
# "anthropic" (API de Claude, vía créditos de la consola de Anthropic).
LLM_PROVIDER=ollama

# Ollama Cloud / API Configuration
OLLAMA_HOST=https://ollama.com
OLLAMA_API_KEY=your_ollama_cloud_api_key_here
# Nota: /api/embed no está autorizado por el plan de Ollama Cloud (siempre 401),
# por lo que el motor local de embeddings se usa automáticamente como fallback.
OLLAMA_EMBED_MODEL=nomic-embed-text
# El chat requiere un modelo alojado en la nube (ver: https://ollama.com/search?c=cloud)
OLLAMA_CHAT_MODEL=gpt-oss:20b

# Anthropic (Claude) — solo se usa si LLM_PROVIDER=anthropic.
# Crear la key en console.anthropic.com > Settings > API Keys (requiere
# créditos cargados en Billing).
ANTHROPIC_API_KEY=
# Modelo económico recomendado para esta app (conversación + extracción de
# datos estructurados, no tareas de razonamiento pesado).
ANTHROPIC_MODEL=claude-haiku-4-5

# OpenAI Whisper (transcripción de audios/notas de voz de WhatsApp).
# Crear la key en platform.openai.com > API Keys (requiere método de pago
# cargado en Billing; el costo de Whisper es de ~$0.006 por minuto de audio).
# Sin esta key, los audios se guardan igual pero el bot no los procesa
# (queda el placeholder "[Audio]", como antes).
OPENAI_API_KEY=

# Base de datos MySQL (leads del funnel de ventas) - ver db/README.md
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=minirag_leads

# Autenticación (login interno: Panel de Leads / Proyectos / Roles y Permisos)
# Genera un valor propio, p. ej.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_this_to_a_random_secret
JWT_EXPIRES_IN=8h

# Configuración de Correo SMTP (Opcional - Si no se configura, se usará Ethereal Mail automático)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_correo@gmail.com
SMTP_PASS=tu_app_password
SMTP_FROM="Evaluador de Tesis Perú <no-reply@tesisperu.edu.pe>"

# Meta (Facebook/Instagram) Lead Ads - Webhook de leads
# Endpoint: GET/POST /api/webhooks/meta
# META_VERIFY_TOKEN: texto que tú inventas; debe coincidir con el que pongas
#   en "Identificador de verificación" al configurar el webhook en Meta.
# META_APP_SECRET: "Configuración de la aplicación" > Básica, en developers.facebook.com.
#   Se usa para validar la firma X-Hub-Signature-256 de cada evento.
# META_PAGE_ACCESS_TOKEN: token de acceso de la Página (no el de la app), obtenido
#   vía "Inicio de sesión con Facebook para empresas" o el Explorador de la API Graph,
#   con permisos leads_retrieval, pages_show_list y pages_manage_metadata.
#   Para que el panel de Instagram (perfil, publicaciones, comentarios) también
#   funcione con datos reales, este mismo token necesita además los permisos
#   instagram_basic, instagram_manage_comments, pages_read_engagement y
#   business_management, y la Página debe tener una cuenta de Instagram
#   Profesional vinculada (Meta Business Suite > Configuración > Cuentas vinculadas).
META_VERIFY_TOKEN=un_token_secreto_que_tu_inventas
META_APP_SECRET=
META_PAGE_ACCESS_TOKEN=
META_GRAPH_API_VERSION=v21.0
# Cada cuánto se sondea el conteo de seguidores de la página (ms). Por defecto 1 hora.
META_FOLLOWER_POLL_INTERVAL_MS=3600000

# Meta Marketing API (Ads) - Módulo de Campañas
# Permite sincronizar las campañas de Meta Ads, mapear sus anuncios
# automáticamente (para atribuir el tráfico Click-to-WhatsApp por el
# referral.source_id) y traer métricas reales: gasto, impresiones, alcance,
# clics, CPM, CPC, CTR y conversaciones de mensajería iniciadas.
# Endpoint interno: POST /api/campaigns/meta/sync (botón "Sincronizar con Meta").
#
# META_ADS_ACCOUNT_ID: ID de la cuenta publicitaria, con o sin el prefijo "act_"
#   (Meta Ads Manager > Configuración de la cuenta, o Business Manager > Cuentas
#   publicitarias). Ej.: act_1234567890 o 1234567890
# META_ADS_ACCESS_TOKEN: token con el permiso "ads_read". Puede ser un token de
#   Usuario del Sistema (recomendado, no expira) generado en Business Manager >
#   Usuarios del sistema. Si tu META_PAGE_ACCESS_TOKEN de arriba YA incluye
#   ads_read, puedes dejar este vacío y se reutiliza ese.
META_ADS_ACCOUNT_ID=
META_ADS_ACCESS_TOKEN=

# TikTok Business API (Marketing API) - Módulo de Campañas
# El equivalente de Meta Ads para TikTok: sincroniza la jerarquía completa
# (campaña > grupo de anuncios > anuncio) y trae las métricas del informe
# (gasto, resultados y coste por resultado, alcance, frecuencia, impresiones,
# CPM, clics, CTR/CPC, reproducciones de video e interacciones).
# Endpoints internos: GET  /api/campaigns/tiktok/auth-url      (paso 1: autorizar)
#                     POST /api/campaigns/tiktok/exchange-code (paso 2: canjear)
#                     GET  /api/campaigns/tiktok/status
#                     POST /api/campaigns/tiktok/sync   (boton "Sincronizar con TikTok")
#
# Como obtenerlas (paso a paso detallado en README.md > "Conectar TikTok Ads"):
# TIKTOK_APP_ID / TIKTOK_APP_SECRET: business-api.tiktok.com > Developers >
#   My Apps > tu app > Basic Information ("App ID" y "Secret").
# TIKTOK_REDIRECT_URI: una de las "Advertiser redirect URL" declaradas en la app.
#   TikTok exige HTTPS, asi que en local se usa la URL de produccion y se copia
#   el auth_code de la barra de direcciones a mano.
# TIKTOK_ACCESS_TOKEN: lo devuelve POST /api/campaigns/tiktok/exchange-code al
#   canjear el auth_code. NO caduca mientras el anunciante no revoque la app.
# TIKTOK_ADVERTISER_ID (opcional): ID de la cuenta publicitaria (TikTok Ads
#   Manager > esquina superior derecha, o la barra de direcciones: aadvid=...).
#   Si se deja vacio se descubre sola con el token (usa la primera autorizada).
# TIKTOK_API_VERSION (opcional): version de la Business API, por defecto v1.3.
TIKTOK_APP_ID=
TIKTOK_APP_SECRET=
TIKTOK_ACCESS_TOKEN=
TIKTOK_ADVERTISER_ID=
TIKTOK_REDIRECT_URI=
TIKTOK_API_VERSION=v1.3

# Instagram Graph API / Messaging - Webhook de Instagram
# Endpoint: GET/POST /api/webhooks/instagram
# META_INSTAGRAM_VERIFY_TOKEN: texto que tú inventas; debe coincidir con el que pongas
#   en "Identificador de verificación" al configurar el webhook de Instagram en Meta Developers.
META_INSTAGRAM_VERIFY_TOKEN=avantage_instagram_webhook_9d4e2a1b
# META_INSTAGRAM_ACCOUNT_ID (opcional): ID numérico de la cuenta de Instagram Business
#   (Meta Business Suite > Configuración > Cuentas > Instagram, o GET /me/accounts con
#   el campo instagram_business_account). Solo hace falta si el bot no logra resolverlo
#   automáticamente a partir de META_PAGE_ACCESS_TOKEN.
META_INSTAGRAM_ACCOUNT_ID=
# META_INSTAGRAM_APP_SECRET (opcional): solo si la suscripción de webhooks de
#   Instagram vive en una app de Meta distinta a la que usa META_APP_SECRET
#   arriba (cada app tiene su propio App Secret). Si no se define, se usa
#   META_APP_SECRET para validar la firma X-Hub-Signature-256 de este webhook.
META_INSTAGRAM_APP_SECRET=

# WhatsApp Business Platform - Webhook de mensajes

# Endpoint: GET/POST /api/webhooks/whatsapp (usa el mismo META_APP_SECRET de arriba
# para validar la firma; este producto tiene su propio campo de verify token en Meta).
#
# CAMPOS A SUSCRIBIR en Meta (app > WhatsApp > Configuracion > Webhook fields):
#   - "messages": los mensajes que escribe el contacto. Sin esto no hay bot.
#   - "smb_message_echoes": OBLIGATORIO en modo coexistencia (el numero tambien
#     esta vinculado a la app de WhatsApp Business del celular). Es por donde
#     Meta reenvia lo que un setter escribe DESDE esa app o desde un
#     dispositivo enlazado. Sirve para dos cosas: que esos mensajes aparezcan
#     en el hilo del panel, y que el bot se PAUSE solo para ese contacto
#     (whatsappWebhookService.handleEchoes).
#     Sin la suscripcion el codigo nunca recibe el evento: Avan sigue creyendo
#     que nadie atiende, manda "¿Sigues por ahi?" encima del setter y puede
#     revivir la conversacion con un "Perdona la demora".
#
#     CUIDADO CON EL NOMBRE: en la lista de campos del panel de Meta hay otro
#     parecido, "message_echoes" SIN el prefijo "smb". Ese es el eco de lo que
#     sale por la Cloud API, NO es el de coexistencia, y en estas cuentas
#     suscribirlo falla con "Error de suscripcion al campo del webhook". El
#     que hay que activar es "smb_message_echoes", mas abajo en la lista
#     (esta ordenada alfabeticamente, asi que cae bajo la "s").
#
#     Para comprobar que llegan: GET /api/webhooks/whatsapp/events, o el log
#     del servidor, que imprime campos=[...] en cada POST recibido.
# Alertas internas del bot de WhatsApp (lead transferido a un asesor,
# recordatorio que no se pudo entregar). Van SIEMPRE por correo y por la
# campana del panel, nunca dependen de WhatsApp: el numero interno casi nunca
# tiene abierta la ventana de 24 h, y por eso esas alertas se perdian.
# Se usa "sales_notification_email" de la configuracion del bot si esta puesto;
# si no, este correo.
INTERNAL_ALERT_EMAIL=kevalva.meza@gmail.com

META_WHATSAPP_VERIFY_TOKEN=otro_token_secreto_que_tu_inventas
# Necesarios para RESPONDER mensajes (POST .../messages de la Graph API):
# META_WHATSAPP_PHONE_NUMBER_ID: en WhatsApp > Configuración de la API, "ID del número de teléfono"
#   del número conectado (no el número en sí).
# META_WHATSAPP_ACCESS_TOKEN: token con permiso whatsapp_business_messaging. Si no se define,
#   se reutiliza META_PAGE_ACCESS_TOKEN.
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_ACCESS_TOKEN=

# WhatsApp Embedded Signup (Facebook Login for Business) - vincular números
# desde el panel, en modo coexistencia con la app móvil de WhatsApp Business.
# Endpoints: GET /api/whatsapp/embedded-signup/config, POST /api/whatsapp/embedded-callback.
#
# META_APP_ID: developers.facebook.com > tu app > Configuración > Básica,
#   campo "ID de la aplicación" (dato público, se usa en FB.init del frontend).
#   Reutiliza el mismo META_APP_SECRET de arriba para el intercambio de código.
# META_WHATSAPP_EMBEDDED_CONFIG_ID: developers.facebook.com > tu app >
#   WhatsApp > Configuración del producto (o "Embedded Signup") > crea una
#   "Configuration" de tipo Facebook Login for Business con los permisos
#   whatsapp_business_management y whatsapp_business_messaging. El ID de esa
#   configuración es este valor (dato público, se manda en FB.login).
META_APP_ID=
META_WHATSAPP_EMBEDDED_CONFIG_ID=

# WhatsApp vía YCloud (alternativa a la Graph API directa de Meta)
# Usar cuando el número se vinculó en modo coexistencia a través de YCloud
# (BSP) en vez de completar el alta como Tech Provider de Meta.
#
# WHATSAPP_PROVIDER: "meta" (por defecto) o "ycloud". Con "ycloud",
#   whatsappMessageService.sendTextMessage/sendTypingIndicator usan la API de
#   YCloud en vez de la Graph API (sendMediaMessage todavía NO está soportado
#   con este proveedor). El bot y el panel de leads no requieren ningún otro
#   cambio: ambos ya usan estos métodos.
# YCLOUD_API_KEY: dashboard.ycloud.com > Developer > API Keys.
# YCLOUD_WEBHOOK_SECRET: se genera al crear el endpoint en
#   dashboard.ycloud.com > Developer > Webhooks > Add Endpoint — URL:
#   https://tu-dominio/api/webhooks/ycloud, eventos: whatsapp.inbound_message.received,
#   whatsapp.message.updated y whatsapp.smb.message.echoes (este último es
#   necesario para que los mensajes que un asesor envía directo desde la app
#   de WhatsApp Business vinculada, o desde el inbox propio de YCloud, se
#   guarden en el panel — sin él, el hilo del panel se ve con saltos respecto
#   a lo que el contacto realmente recibió). Se usa para validar la firma
#   "YCloud-Signature" de cada evento entrante.
# YCLOUD_WHATSAPP_FROM: número de WhatsApp Business vinculado, en formato
#   internacional con "+" (ej. +51987654321) — es el "from" de cada envío.
WHATSAPP_PROVIDER=meta
YCLOUD_API_KEY=
YCLOUD_WEBHOOK_SECRET=
YCLOUD_WHATSAPP_FROM=
# Rango de espera (ms) antes de cada mensaje automático de Avan por WhatsApp,
# para simular tiempo de "escribiendo..." y evitar ráfagas que WhatsApp pueda
# marcar como comportamiento de spam/bot.
WHATSAPP_BOT_DELAY_MIN_MS=1500
WHATSAPP_BOT_DELAY_MAX_MS=3500
# Tiempo de silencio (ms) que se espera tras el/los primer(os) mensaje(s) de un
# contacto nuevo antes de juntarlos en un solo texto y generar el saludo de
# bienvenida con el LLM de Ollama Cloud (ver OllamaService.generateWelcomeMessage).
# Espera de silencio antes de procesar un turno, para juntar las burbujas que
# el contacto manda seguidas. Más alta al inicio de la conversación (es cuando
# más entrecortado se escribe) y más corta en el agendamiento y después de
# agendar, donde la respuesta suele venir en una sola burbuja.
WHATSAPP_BOT_FIRST_MESSAGE_DEBOUNCE_MS=7000
WHATSAPP_BOT_SCHEDULING_DEBOUNCE_MS=5000
WHATSAPP_BOT_POST_BOOKING_DEBOUNCE_MS=5000
# Excepción: el "¿Confirmo <horario>?" espera más que el resto del agendamiento.
# Ahí la respuesta llega partida con mucha más frecuencia, porque al sí se le
# pega un pedido ("Si esta bien.." + "Me envía enlace por este numero"), y cada
# burbuja abriendo su propio turno hacía perder la reunión ya aceptada. Es el
# único paso donde esperar de más no cuesta nada: el contacto acaba de decir sí.
WHATSAPP_BOT_CONFIRM_DEBOUNCE_MS=12000
# Prórroga extra (una sola vez) cuando lo único recibido es un saludo suelto
# ("hola", "buenas tardes"): casi siempre viene seguido del mensaje real.
WHATSAPP_BOT_GREETING_EXTRA_WAIT_MS=8000
# Anticipación mínima (minutos) para reservar un bloque: nada que empiece antes
# de ese margen se le ofrece al contacto. Con 60, a las 3:42 p.m. el bloque de
# las 5:30 p.m. sigue disponible y "hoy" no desaparece de la agenda tan pronto.
WHATSAPP_BOOKING_MIN_LEAD_MINUTES=60
