{
  "name": "minirag-tesis-viabilidad",
  "version": "1.0.0",
  "description": "Evaluador de Viabilidad de Temas de Tesis en Perú con Node.js, Vue 3, Ollama Cloud y Email",
  "main": "boot.cjs",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "node --watch backend/server.js",
    "start": "node boot.cjs",
    "build": "vite build",
    "preview": "vite preview",
    "migrate": "knex migrate:latest --knexfile backend/db/knexfile.js",
    "migrate:rollback": "knex migrate:rollback --knexfile backend/db/knexfile.js",
    "migrate:status": "knex migrate:status --knexfile backend/db/knexfile.js",
    "migrate:make": "knex migrate:make --knexfile backend/db/knexfile.js -x js --migrations-directory backend/db/migrations",
    "seed": "knex seed:run --knexfile backend/db/knexfile.js",
    "test": "node --test \"backend/**/*.test.js\"",
    "backfill:meta-leadgen-fields": "node backend/scripts/backfillMetaLeadgenFields.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.126.0",
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/controls": "^1.1.3",
    "@vue-flow/core": "^1.48.2",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "googleapis": "^176.0.0",
    "jsonwebtoken": "^9.0.3",
    "knex": "^3.3.0",
    "lucide-vue-next": "^1.0.0",
    "multer": "^2.4.0",
    "mysql2": "^3.23.2",
    "nodemailer": "^9.1.1",
    "ollama": "^0.5.1",
    "pdf-lib": "^1.17.1",
    "vue": "^3.5.44",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.4",
    "vite": "^6.4.4"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
